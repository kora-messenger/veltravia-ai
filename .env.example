# The API's own settings. Copy to .env for local work; a host sets these itself.
#
# Mode decides how strict startup is: staging and production refuse to boot with
# a missing credential key, a non-https public URL or a wildcard CORS origin.
NODE_ENV=development
API_PORT=3100

# Where clients reach this API. Required for a remote deployment, https only.
VELTRAVIA_PUBLIC_API_URL=http://localhost:3100

# The web origins allowed to call it. Never "*".
VELTRAVIA_CORS_ORIGINS=http://localhost:5199

# Encrypts stored provider keys. 32 bytes, base64. Without it nothing is stored.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VELTRAVIA_CREDENTIAL_KEY=

# The server's model key: set it and nobody needs to paste one.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# How many answers one person may have per UTC day. 0 lifts the ceiling.
VELTRAVIA_DAILY_REQUEST_CEILING=200

# memory for local work, file for a host that keeps data across restarts.
VELTRAVIA_STORAGE_DRIVER=memory
# VELTRAVIA_DATA_DIR=/app/data
