# =============================================================================
# Veltravia AI - environment template
# Copy to .env for local development. NEVER commit the real .env file.
# CI and production use GitHub Actions secrets / a secret manager, not this file.
# =============================================================================

NODE_ENV=development

# --- API ---------------------------------------------------------------------
# Bind address and port. A platform normally supplies PORT; API_PORT overrides.
API_HOST=0.0.0.0
API_PORT=3000

# --- Deployment (Step 37) -----------------------------------------------------
# NODE_ENV selects the deployment mode: development | test | staging | production.
# In staging and production the API REFUSES TO START when anything below is
# missing or unsafe, rather than starting with a laptop configuration.
#
# The API's own public address, as clients address it. Must be https and must not
# be localhost in staging/production. The Android build reads this at package time.
VELTRAVIA_PUBLIC_API_URL=https://api.example-staging.test

# Exact web origins allowed to call the API, comma separated. Never "*".
# With no entry, no cross-origin caller is allowed at all.
VELTRAVIA_CORS_ORIGINS=https://app.example-staging.test

# Where durable state lives. memory = nothing survives a restart (development);
# file = JSON collections under VELTRAVIA_DATA_DIR, written atomically.
VELTRAVIA_STORAGE_DRIVER=memory
VELTRAVIA_DATA_DIR=

# Believe X-Forwarded-For only when a proxy you control sets it.
VELTRAVIA_TRUST_PROXY=false

# Request ceilings. The 40 MB default leaves room for a base64 image upload.
VELTRAVIA_BODY_LIMIT_BYTES=41943040
VELTRAVIA_REQUEST_TIMEOUT_MS=30000
VELTRAVIA_CONNECTION_TIMEOUT_MS=10000
VELTRAVIA_SHUTDOWN_GRACE_MS=10000

# silent | fatal | error | warn | info | debug | trace
VELTRAVIA_LOG_LEVEL=info

# --- Database (future) -------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/veltravia

# --- Authentication (future) -------------------------------------------------
AUTH_JWT_SECRET=replace-with-a-generated-secret
AUTH_SESSION_SECRET=replace-with-a-generated-secret

# --- Application secrets ------------------------------------------------------
APP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# Encrypts stored provider credentials (AES-256-GCM). REQUIRED in staging and
# production: without it the gateway refuses to store any key, and the API does
# not start. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: set VELTRAVIA_CREDENTIAL_KEYS to "new,old" (comma separated) so
# existing records still decrypt, then remove the old key once everything is
# re-saved. Never commit a real value.
VELTRAVIA_CREDENTIAL_KEY=
VELTRAVIA_CREDENTIAL_KEYS=

# --- Storage (future) ----------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# --- GitHub integration (future) ----------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_TOKEN=

# --- Connector credentials (future) --------------------------------------------
# Isolated per connector; never exposed to generated project code.
CONNECTOR_SLACK_CLIENT_ID=
CONNECTOR_SLACK_CLIENT_SECRET=

# --- AI Core (Step 2) ---------------------------------------------------------
# No real provider keys yet - adapters arrive in a later step.
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=
AI_ENABLED_PROVIDERS=mock
AI_MAX_INPUT_MESSAGES=100
AI_MAX_INPUT_CHARS=10000
AI_REQUEST_TIMEOUT_MS=60000

# --- Real AI provider keys (FUTURE - not used by Step 2) ----------------------
# Adapters will read these via the connector/secret system, never from code.
VELTRAVIA_AI_OPENAI_API_KEY=
VELTRAVIA_AI_ANTHROPIC_API_KEY=
VELTRAVIA_AI_GOOGLE_API_KEY=
VELTRAVIA_AI_OPENROUTER_API_KEY=

# --- Gemini provider (Step 3) -------------------------------------------------
# Server-side only. The key is read exclusively by the Gemini adapter
# (ai/providers/gemini), passed to the Google SDK at client construction,
# and never logged, returned in responses, or shipped to the web client.
GEMINI_API_KEY=
# Default Gemini model (must be a current, supported model id).
GEMINI_MODEL=gemini-3.8-flash
# Per-request timeout in milliseconds.
GEMINI_REQUEST_TIMEOUT_MS=30000
# Master switch: 'false' un-registers the adapter even when a key exists.
GEMINI_ENABLED=true
# Whether Gemini may store interactions server-side (default false - Veltravia
# is stateless per request; enabling is a prerequisite for stateful mode).
GEMINI_STORE_INTERACTIONS=false
# Optional default thinking level: minimal | low | medium | high
GEMINI_THINKING_LEVEL=

# --- Optional live Gemini integration tests -----------------------------------
# NEVER set these in CI. Set locally to run tests/live/gemini.live.test.ts
# against the real Gemini API; without them the suite always skips.
RUN_GEMINI_INTEGRATION_TESTS=
