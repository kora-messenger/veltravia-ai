# =============================================================================
# Veltravia AI - environment template
# Copy to .env for local development. NEVER commit the real .env file.
# CI and production use GitHub Actions secrets / a secret manager, not this file.
# =============================================================================

NODE_ENV=development

# --- API ---------------------------------------------------------------------
API_PORT=3000

# --- Database (future) -------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/veltravia

# --- Authentication (future) -------------------------------------------------
AUTH_JWT_SECRET=replace-with-a-generated-secret
AUTH_SESSION_SECRET=replace-with-a-generated-secret

# --- Application secrets ------------------------------------------------------
APP_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key

# --- Storage (future) ----------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# --- GitHub integration (future) ----------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_TOKEN=

# --- Connector credentials (future) --------------------------------------------
# Isolated per connector; never exposed to generated project code.
CONNECTOR_SLACK_CLIENT_ID=
CONNECTOR_SLACK_CLIENT_SECRET=

# --- AI Core (Step 2) ---------------------------------------------------------
# No real provider keys yet - adapters arrive in a later step.
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=
AI_ENABLED_PROVIDERS=mock
AI_MAX_INPUT_MESSAGES=100
AI_MAX_INPUT_CHARS=10000
AI_REQUEST_TIMEOUT_MS=60000

# --- Real AI provider keys (FUTURE - not used by Step 2) ----------------------
# Adapters will read these via the connector/secret system, never from code.
VELTRAVIA_AI_OPENAI_API_KEY=
VELTRAVIA_AI_ANTHROPIC_API_KEY=
VELTRAVIA_AI_GOOGLE_API_KEY=
VELTRAVIA_AI_OPENROUTER_API_KEY=
